<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { title: 'GeoRisco — Login' }) %>
  <style>
    body {
      background-color: var(--color-login-bg);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      overflow: hidden;
      position: relative;
    }
    .bg-circle { position: absolute; border-radius: 50%; pointer-events: none; }
    .bg-circle-1 { width: 420px; height: 420px; background: #5c3220; top: -80px; right: -80px; opacity: 0.7; }
    .bg-circle-2 { width: 320px; height: 320px; background: #1e3a1e; bottom: -60px; right: 80px; opacity: 0.8; }
    .bg-circle-3 { width: 200px; height: 200px; background: #5c3220; bottom: 60px; left: -60px; opacity: 0.5; }

    .login-card {
      background: #fff;
      border-radius: var(--radius-lg);
      padding: 40px 36px;
      width: 100%;
      max-width: 380px;
      box-shadow: var(--shadow-card-strong);
      position: relative;
      z-index: 1;
    }
    .login-logo { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
    .login-logo .brand-icon { width: 40px; height: 40px; border-radius: 10px; font-size: 20px; }
    .login-logo__text strong { display: block; font-size: 16px; color: var(--color-text); }
    .login-logo__text span { display: block; font-size: 11px; color: #888; }
    .login-card h1 { font-size: 22px; margin-bottom: 4px; color: var(--color-text); }
    .login-card .subtitle { font-size: 13px; color: var(--color-text-muted); margin-bottom: 28px; }
    .password-wrapper { position: relative; }
    .password-wrapper .form-control { padding-right: 42px; }
    .toggle-senha {
      position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
      background: none; border: none; color: #aaa; display: flex; padding: 0;
    }
    .toggle-senha:hover { color: #666; }
    .login-card .form-control:focus { border-color: var(--color-brand); box-shadow: 0 0 0 3px rgba(249,115,22,0.18); }
    .link-esqueceu { display: block; text-align: center; color: var(--color-brand); font-size: 13px; font-weight: 500; margin-top: 16px; }
    .link-esqueceu:hover { text-decoration: underline; }
    footer.login-footer { position: relative; z-index: 1; margin-top: 28px; color: rgba(255,255,255,0.35); font-size: 11px; text-align: center; }
  </style>
</head>
<body>
  <div class="bg-circle bg-circle-1"></div>
  <div class="bg-circle bg-circle-2"></div>
  <div class="bg-circle bg-circle-3"></div>

  <main class="login-card">
    <div class="login-logo">
      <span class="brand-icon">G</span>
      <div class="login-logo__text">
        <strong>GeoRisco</strong>
        <span>Santo André</span>
      </div>
    </div>

    <h1>Bem-vindo!</h1>
    <p class="subtitle">Acesse sua conta para continuar</p>

    <div id="alertErro" class="alert alert--error" style="display:none;">
      <span id="alertErroTexto">Credenciais inválidas. Tente novamente.</span>
    </div>

    <form id="loginForm" novalidate>
      <div class="form-field">
        <label for="email">E-mail</label>
        <input type="email" id="email" class="form-control"
               placeholder="email@prefeitura.sp.gov.br" autocomplete="email" required />
      </div>

      <div class="form-field">
        <label for="senha">Senha</label>
        <div class="password-wrapper">
          <input type="password" id="senha" class="form-control"
                 placeholder="••••••••" autocomplete="current-password" required />
          <button type="button" class="toggle-senha" id="toggleSenha" aria-label="Mostrar senha">
            <svg id="iconOlho" width="20" height="20" fill="none" viewBox="0 0 24 24"
                 stroke="currentColor" stroke-width="1.8">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
              <circle cx="12" cy="12" r="3" />
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn--brand btn--block" id="btnEntrar">
        <span class="btn-label">Entrar</span>
      </button>
    </form>

    <a href="#" class="link-esqueceu">Esqueceu sua senha?</a>
  </main>

  <footer class="login-footer">
    GeoRisco | Santo André &mdash; Sistema Integrado de Assistência Social
  </footer>

  <script src="/js/api.js?v=20260626-1"></script>
  <script src="/js/login.js?v=20260626-2"></script>
</body>
</html>
