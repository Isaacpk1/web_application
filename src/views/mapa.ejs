<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <%- include('partials/head', { title }) %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    html, body { margin: 0; padding: 0; height: 100%; overflow: hidden; }

    /* ── mapa container abaixo da navbar padrão ── */
    .mapa-container {
      position: fixed;
      top: 0;
      left: 240px; right: 0; bottom: 0;
    }
    #leaflet-map { width: 100%; height: 100%; }
    @media (max-width: 900px) {
      .mapa-container { left: 200px; }
    }
    @media (max-width: 640px) {
      html, body { overflow: auto; }
      .mapa-container { left: 0; top: 0; }
    }

    /* ── painel de filtros ── */
    .mapa-filter-panel {
      position: absolute; top: 16px; left: 16px; z-index: 500;
      background: #fff; border-radius: 12px; padding: 16px; width: 224px;
      box-shadow: 0 4px 24px rgba(0,0,0,.15);
    }
    .mapa-filter-title {
      display: flex; justify-content: space-between; align-items: center;
      font-weight: 700; font-size: 13px; margin-bottom: 12px;
    }
    .filter-field { margin-bottom: 10px; }
    .filter-label {
      display: block; font-size: 11px; font-weight: 600; color: #6b7280;
      margin-bottom: 4px; text-transform: uppercase; letter-spacing: .5px;
    }
    .filter-select {
      width: 100%; padding: 7px 10px; border: 1px solid #e5e7eb;
      border-radius: 8px; font-size: 13px; background: #f9fafb; color: #111827;
    }
    .btn-clear-filter {
      font-size: 11px; color: #6b7280; background: none;
      border: none; cursor: pointer; text-decoration: underline;
    }
    .btn-apply-filter {
      width: 100%; padding: 9px; background: #F97316; color: #fff;
      border: none; border-radius: 8px; font-size: 13px; font-weight: 700;
      cursor: pointer; margin-top: 4px;
    }
    .btn-apply-filter:hover { background: #EA6B0E; }

    /* ── legenda ── */
    .mapa-legend {
      position: absolute; bottom: 32px; right: 16px; z-index: 500;
      background: #fff; border-radius: 10px; padding: 12px 14px;
      box-shadow: 0 4px 16px rgba(0,0,0,.12);
    }
    .mapa-legend__title {
      font-size: 11px; font-weight: 700; color: #374151;
      text-transform: uppercase; letter-spacing: .5px; margin-bottom: 8px;
    }
    .mapa-legend__item {
      display: flex; align-items: center; gap: 8px;
      font-size: 12px; color: #374151; margin-bottom: 4px;
    }

    /* ── popup Leaflet ── */
    .leaflet-popup-content-wrapper { border-radius: 12px; box-shadow: 0 8px 32px rgba(0,0,0,.18); }
    .leaflet-popup-content { margin: 0; padding: 0; }
    .map-popup { padding: 16px 18px; min-width: 220px; }
    .map-popup h3 { font-size: 16px; font-weight: 700; margin-bottom: 10px; }
    .map-popup-row { display: flex; gap: 6px; font-size: 13px; margin-bottom: 5px; }
    .map-popup-row span:first-child { color: #6B7280; min-width: 100px; }
    .map-popup-btn {
      display: block; width: 100%; margin-top: 12px; padding: 9px;
      background: #F97316; color: #fff; border-radius: 8px;
      text-align: center; font-size: 13px; font-weight: 700; text-decoration: none;
    }
    .map-popup-btn:hover { background: #EA6B0E; }
  </style>
</head>
<body>

  <div class="layout">
    <%- include('partials/sidebar', { active: 'mapa' }) %>
    <div class="main">
  <!-- Mapa Leaflet -->
  <div class="mapa-container">
    <div id="leaflet-map"></div>

    <!-- Painel de filtros -->
    <div class="mapa-filter-panel">
      <div class="mapa-filter-title">
        Filtros do Mapa
        <button class="btn-clear-filter" id="btn-clear">Limpar</button>
      </div>
      <div class="filter-field">
        <label class="filter-label">Gênero</label>
        <select class="filter-select" id="f-genero">
          <option value="">Todos</option>
          <option>Masculino</option>
          <option>Feminino</option>
        </select>
      </div>
      <div class="filter-field">
        <label class="filter-label">Bairro / Região</label>
        <select class="filter-select" id="f-bairro">
          <option value="">Selecionar bairro</option>
          <option>Centro</option>
          <option>Jardins</option>
          <option>Norte</option>
          <option>Sul</option>
          <option>Leste</option>
          <option>Campestre</option>
          <option>Vila Assunção</option>
          <option>Jardim Bela Vista</option>
          <option>Vila Bastos</option>
          <option>Capuava</option>
        </select>
      </div>
      <div class="filter-field">
        <label class="filter-label">Tipo de Construção</label>
        <select class="filter-select" id="f-tipo">
          <option value="">Todos os tipos</option>
          <option>Alvenaria</option>
          <option>Madeira</option>
          <option>Misto</option>
        </select>
      </div>
      <div class="filter-field">
        <label class="filter-label">Nível de Vulnerabilidade</label>
        <select class="filter-select" id="f-nivel">
          <option value="">Todos os níveis</option>
          <option value="MUITO_ALTO">Muito Alto</option>
          <option value="ALTO">Alto</option>
          <option value="MEDIO">Médio</option>
          <option value="BAIXO">Baixo</option>
        </select>
      </div>
      <button class="btn-apply-filter" id="btn-apply">Aplicar filtros</button>
    </div>

    <!-- Legenda -->
    <div class="mapa-legend">
      <div class="mapa-legend__title">Legenda</div>
      <div class="mapa-legend__item"><svg width="12" height="12"><circle cx="6" cy="6" r="6" fill="#EF4444"/></svg> Risco extremo</div>
      <div class="mapa-legend__item"><svg width="12" height="12"><circle cx="6" cy="6" r="6" fill="#F97316"/></svg> Risco alto</div>
      <div class="mapa-legend__item"><svg width="12" height="12"><circle cx="6" cy="6" r="6" fill="#22C55E"/></svg> Risco médio</div>
    </div>
  </div>

    </div>
  </div>

  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/mapa.js"></script>
</body>
</html>
