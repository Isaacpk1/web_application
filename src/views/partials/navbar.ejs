<%
  /* `active`: 'analise-dados' | 'mapa' | 'cadastro' */
  const current = typeof active !== 'undefined' ? active : '';
%>
<header>
  <nav class="navbar navbar--sias">
    <a class="navbar__brand" href="/admin/analise-dados">GeoRisco</a>

    <button class="nav-toggle" data-nav-toggle aria-label="Abrir menu">&#9776;</button>

    <div class="navbar__links" data-nav-links>
      <a href="/admin/analise-dados" class="<%= current === 'analise-dados' ? 'active' : '' %>">Análise de Dados</a>
      <a href="/mapa" class="<%= current === 'mapa' ? 'active' : '' %>">Mapa de Risco</a>
      <a href="/agente/cadastro" class="<%= current === 'cadastro' ? 'active' : '' %>">Novo Cadastro</a>
    </div>

    <div class="navbar__right">
      <button class="navbar__icon-btn" title="Notificações" aria-label="Notificações">&#128276;</button>
      <button class="navbar__icon-btn" data-theme-toggle title="Ativar modo escuro" aria-label="Alternar modo escuro">&#9790;</button>
      <div class="navbar__avatar-block">
        <span class="avatar" data-nav-avatar>MS</span>
        <div class="navbar__avatar-info">
          <strong data-nav-name>Maria Silva</strong>
          <span>Assistente Social</span>
        </div>
      </div>
      <button class="btn-logout" data-logout>Sair</button>
    </div>
  </nav>
</header>
