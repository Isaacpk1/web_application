{
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/cohere/north-mini-code:free",
  "small_model": "openrouter/cohere/north-mini-code:free",

  "permission": {
    "edit": "ask",
    "bash": "ask"
  },

  "agent": {
    "plan": {
      "mode": "primary",
      "model": "openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      },
      "tools": {
        "context7*": true,
        "postgres*": true,
        "playwright*": false,
        "github*": false
      }
    },

    "build": {
      "mode": "primary",
      "model": "openrouter/cohere/north-mini-code:free",
      "temperature": 0.2,
      "permission": {
        "edit": "allow",
        "bash": "ask"
      },
      "tools": {
        "context7*": true,
        "postgres*": true,
        "playwright*": true,
        "github*": false
      }
    }
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },

    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },

    "postgres": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "{env:DATABASE_URL}"
      ],
      "enabled": true
    },

    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "enabled": false
    }
  },

  "tools": {
    "github*": false
  }
}